cat(sprintf("\\texttt{%s} & %s & %d & %.2f & %.2f & %.2f & %.2f & %.2f & %.2f & %.2f \\\\\n\\hline\n",
bien_tex, row$Don_vi, row$N, row$Mean, row$SD, row$Min, row$Q1, row$Median, row$Q3, row$Max))
}
# 3. Chuẩn bị biến đổi logarit và thư mục lưu ảnh
df_log <- log(df_clean)
img_dir <- "../../img/statisticDes"
if (!dir.exists(img_dir)) {
dir.create(img_dir, recursive = TRUE)
}
# =========================================================
# 4. Histogram Dữ liệu Gốc (Original) - 2 đồ thị / hàng
# =========================================================
hist_orig_list <- list()
for (col in selected_cols) {
p <- ggplot(df_clean, aes(x = .data[[col]])) +
geom_histogram(fill = "gray70", color = "black", bins = 30) +
labs(title = paste("Histogram of", col), x = col, y = "Frequency") +
theme_minimal() +
theme(
plot.title = element_text(face = "bold", size = 11),
axis.title = element_text(size = 10)
)
hist_orig_list[[col]] <- p
}
png(file.path(img_dir, "histograms_original.png"), width = 10, height = 14, units = "in", res = 300)
grid.arrange(grobs = hist_orig_list, ncol = 2)
dev.off()
# =========================================================
# 5. Histogram Dữ liệu Log - 2 đồ thị / hàng
# =========================================================
hist_log_list <- list()
for (col in selected_cols) {
p <- ggplot(df_log, aes(x = .data[[col]])) +
geom_histogram(fill = "gray85", color = "black", bins = 30) +
labs(title = paste0("Histogram of log(", col, ")"),
x = paste0("log(", col, ")"),
y = "Frequency") +
theme_minimal() +
theme(
plot.title = element_text(face = "bold", size = 11),
axis.title = element_text(size = 10)
)
hist_log_list[[col]] <- p
}
png(file.path(img_dir, "histograms_log.png"), width = 10, height = 14, units = "in", res = 300)
grid.arrange(grobs = hist_log_list, ncol = 2)
dev.off()
# =========================================================
# 6. Scatter Plots dạng Log (Core_Speed vs 8 biến còn lại)
# =========================================================
feature_cols <- setdiff(selected_cols, "Core_Speed")
scatter_log_list <- list()
for (col in feature_cols) {
p <- ggplot(df_log, aes(x = .data[[col]], y = .data[["Core_Speed"]])) +
geom_point(color = "orange", alpha = 0.6, size = 1.5) +
labs(title = paste0("Scatter Plot of log(", col, ") with log(Core_Speed)"),
x = paste0("log(", col, ")"),
y = "log(Core_Speed)") +
theme_minimal() +
theme(
plot.title = element_text(face = "bold", size = 10),
axis.title = element_text(size = 10)
)
scatter_log_list[[col]] <- p
}
png(file.path(img_dir, "scatter_log.png"), width = 10, height = 12, units = "in", res = 300)
grid.arrange(grobs = scatter_log_list, ncol = 2)
dev.off()
for (i in 1:nrow(summary_stats)) {
r <- summary_stats[i, ]
cat(sprintf("\\texttt{%s} & %s & %d & %.2f & %.2f & %.2f & %.2f & %.2f & %.2f & %.2f \\\\\n\\hline\n",
gsub("_", "\\\\_", r$Bien), r$Don_vi, r$N, r$Mean, r$SD, r$Min, r$Q1, r$Median, r$Q3, r$Max))
}
