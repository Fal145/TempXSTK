summary_stats <- data.frame(
Bien = selected_cols,
Don_vi = units,
N = sapply(df_clean[selected_cols], length),
Mean = round(sapply(df_clean[selected_cols], mean), 2),
SD = round(sapply(df_clean[selected_cols], sd), 2),
Min = round(sapply(df_clean[selected_cols], min), 2),
