# Chuyển cột Manufacturer sang dạng biến phân loại (factor)
df_clean$Manufacturer <- as.factor(df_clean$Manufacturer)
# ==============================================================================
# BƯỚC 1: THỐNG KÊ MÔ TẢ THEO TỪNG NHÓM HÃNG
# ==============================================================================
cat("--- THỐNG KÊ CORE_SPEED THEO NHÀ SẢN XUẤT ---\n")
