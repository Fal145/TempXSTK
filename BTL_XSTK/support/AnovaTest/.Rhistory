cat("z_toi_han = ", z_th)
e <- z_th * s / sqrt(n)
cat("e = ", e)
up_lim <- xtb + e
low_lim <- xtb - e
# Đọc file CSV và gán vào biến sourcedata
sourcedata <- read.csv("../data/new_GPUs.csv")
# Trích xuất dữ liệu Memory_Bandwidth
x <- sourcedata$Core_Speed
# Thống kê mẫu
n <- length(x)
x_tb <- mean(x)
s <- sd(x)
# Kiểm tra phân phối chuẩn
result <- shapiro.test(x)
print(result)
# Thiết lập thông số kiểm định
mu_0 <- 160
alpha <- 0.05
# Tính giá trị kiểm định Z và p-value
z_qs <- (x_tb - mu_0) / (s / sqrt(n))
z_th <- qnorm(1 - alpha / 2)
cat("z_toi_han = ", z_th)
e <- z_th * s / sqrt(n)
cat("e = ", e)
up_lim <- x_tb + e
low_lim <- x_tb - e
cat("Khoảng tin cậy: (", low_lim, ", ", up_lim, ")")
p_val <- 2 * (1 - pnorm(abs(z_qs)))
# Hiển thị kết quả
data.frame(
Co_mau = n,
Trung_binh = round(x_tb, 4),
Do_lech_chuan = round(s, 4),
Z_quan_sat = round(z_qs, 4),
Z_toi_han = round(z_th, 4),
P_value = round(p_val, 4)
)
# Nạp thư viện cần thiết (car đã cài ở bước trước)
library(car)
# Chuyển cột Manufacturer sang dạng biến phân loại (factor)
df_clean$Manufacturer <- as.factor(df_clean$Manufacturer)
# ==============================================================================
# BƯỚC 1: THỐNG KÊ MÔ TẢ THEO TỪNG NHÓM HÃNG
# ==============================================================================
cat("--- THỐNG KÊ CORE_SPEED THEO NHÀ SẢN XUẤT ---\n")
aggregate(Core_Speed ~ Manufacturer, data = df_clean,
FUN = function(x) c(n = length(x), Mean = round(mean(x), 2), SD = round(sd(x), 2), Median = round(median(x), 2)))
# ==============================================================================
# BƯỚC 2: KIỂM TRA GIẢ ĐỊNH ĐỒNG NHẤT PHƯƠNG SAI (LEVENE'S TEST)
# ==============================================================================
# Lưu ý: Vì dữ liệu Core_Speed bị lệch phải, nên chạy ANOVA trên biến log(Core_Speed)
# để đảm bảo phân phối chuẩn tốt hơn.
cat("\n--- KIỂM ĐỊNH ĐỒNG NHẤT PHƯƠNG SAI (LEVENE'S TEST) ---\n")
print(leveneTest(log(Core_Speed) ~ Manufacturer, data = df_clean))
