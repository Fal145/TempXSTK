suppressPackageStartupMessages(library(dplyr))
library(stringr)
cat("=== RESULT GIAI ĐOẠN 1 ===\n")
# Đọc file dữ liệu gốc
data_path <- "data/All_GPUs.csv"
df_raw <- read.csv(data_path, na.strings = c("\n-", "-", "None", "", "NA"))
# Lọc 9 biến quan tâm
selected_cols <- c("Core_Speed", "Max_Power", "Memory", "Memory_Bandwidth",
"Memory_Bus", "Memory_Speed", "Process", "ROPs", "TMUs")
df_step1 <- df_raw[, selected_cols]
cat(sprintf("Kích thước bộ dữ liệu: %d dòng x %d cột\n\n", nrow(df_step1), ncol(df_step1)))
print(head(df_step1, 7))
cat("\n---------------------------------------------------------\n\n")
# =========================================================
# GIAI ĐOẠN 2: Tách bỏ đơn vị và chuyển đổi kiểu dữ liệu
# =========================================================
cat("=== RESULT GIAI ĐOẠN 2 ===\n")
extract_numeric <- function(val) {
num <- str_extract(as.character(val), "[0-9.]+")
return(as.numeric(num))
}
df_step2 <- df_step1
for (col in selected_cols) {
df_step2[[col]] <- sapply(df_step2[[col]], extract_numeric)
}
cat("Kiểu dữ liệu của các cột sau khi chuyển đổi:\n")
print(sapply(df_step2, class))
cat("\nHiển thị 7 dòng đầu tiên (đã xóa chữ đơn vị):\n")
print(head(df_step2, 7))
cat("\n---------------------------------------------------------\n\n")
# =========================================================
# GIAI ĐOẠN 3: Chuẩn hóa ô trống và xử lý dữ liệu khuyết
# =========================================================
cat("=== RESULT GIAI ĐOẠN 3 ===\n")
cat("Thống kê số lượng ô trống ở từng cột trước khi xóa:\n")
print(colSums(is.na(df_step2)))
# Xóa dòng chứa NA (Listwise Deletion)
df_step3 <- na.omit(df_step2)
rownames(df_step3) <- NULL # Rerank lại chỉ số dòng
cat(sprintf("\nKích thước dữ liệu sau khi xóa bỏ các dòng có NaN: %d dòng x %d cột\n\n", nrow(df_step3), ncol(df_step3)))
print(head(df_step3, 7))
cat("\n---------------------------------------------------------\n\n")
# =========================================================
# GIAI ĐOẠN 4: Loại bỏ quan sát trùng lặp
# =========================================================
cat("=== RESULT GIAI ĐOẠN 4 ===\n")
duplicates_count <- sum(duplicated(df_step3))
cat(sprintf("Số lượng dòng bị trùng lặp hoàn toàn trên 9 thông số: %d\n", duplicates_count))
df_clean <- distinct(df_step3)
rownames(df_clean) <- NULL
cat(sprintf("Kích thước bộ dữ liệu SẠCH hoàn chỉnh: %d dòng x %d cột\n\n", nrow(df_clean), ncol(df_clean)))
cat("Bảng dữ liệu sạch 100% sẵn sàng cho bước Thống kê:\n")
print(head(df_clean, 7))
# Lưu file kết quả sạch vào thư mục support/data/
write.csv(df_clean, "data/new_GPUs.csv", row.names = FALSE)
source("DataPreprocessing/dataPrep.R", echo = FALSE, print.eval = TRUE)
