# ---------------------------------------------------------
# PHẦN 4: TIỀN XỬ LÝ DỮ LIỆU (DATA PREPROCESSING)
# ---------------------------------------------------------
suppressPackageStartupMessages(library(dplyr))
library(stringr)
# 1. Đọc dữ liệu (Đường dẫn đi lùi 1 cấp thư mục để vào /data)
data_path <- "data/All_GPUs.csv"
All_GPUs <- read.csv(data_path, na.strings = c("\n-", "-", "None", "", "NA"))
selected_cols <- c("Core_Speed", "Max_Power", "Memory", "Memory_Bandwidth",
"Memory_Bus", "Memory_Speed", "Process", "ROPs", "TMUs")
new_GPUs <- All_GPUs[, selected_cols]
# Xem 6 dòng đầu tiên
head(new_GPUs)
# 2. Tách bỏ đơn vị và chuyển sang dạng số (Numeric)
extract_numeric <- function(val) {
num <- str_extract(as.character(val), "[0-9.]+")
return(as.numeric(num))
}
for (col in selected_cols) {
new_GPUs[[col]] <- sapply(new_GPUs[[col]], extract_numeric)
}
# 3. Xử lý dữ liệu khuyết (Listwise Deletion)
cat("Số ô trống ở mỗi cột:\n")
print(colSums(is.na(new_GPUs)))
new_GPUs_clean <- na.omit(new_GPUs)
# 4. Kiểm tra và loại bỏ dòng trùng lặp
new_GPUs_clean <- distinct(new_GPUs_clean)
# 5. Lưu lại file dữ liệu sạch vào thư mục support/data/
write.csv(new_GPUs_clean, "../data/new_GPUs.csv", row.names = FALSE)
