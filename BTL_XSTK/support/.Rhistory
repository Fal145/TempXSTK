load("E:/BTL_Code/BTL_XSTK/support/.RData")
# ==============================================================================
# BÀI TẬP LỚN XÁC SUẤT THỐNG KÊ - MÔ HÌNH HỒI QUY TUYẾN TÍNH BỘI
# ==============================================================================
# 1. ĐỌC DỮ LIỆU SẠCH VÀ BIẾN ĐỔI LOGARITHM
df_clean <- read.csv("../data/new_GPUs.csv")
# Kiểm tra an toàn giá trị 0 trước khi lấy log
if (any(df_clean == 0)) {
df_log <- log(df_clean + 1)
} else {
df_log <- log(df_clean)
}
cat("--- KÍCH THƯỚC BỘ DỮ LIỆU: ", nrow(df_clean), "dòng x", ncol(df_clean), "cột ---\n")
# 2. XÂY DỰNG MÔ HÌNH HỒI QUY
Model1 <- lm(Core_Speed ~ Memory_Bandwidth + Memory + Memory_Speed + Memory_Bus + Process + ROPs + TMUs,
data = df_clean)
Model2 <- lm(Core_Speed ~ Memory_Bandwidth + Memory + Memory_Bus + Process + ROPs + TMUs,
data = df_clean)
# Mô hình 3: Dạng Logarithm đầy đủ 8 biến độc lập
Model3 <- lm(Core_Speed ~ Max_Power + Memory_Bandwidth + Memory + Memory_Speed +
Memory_Bus + Process + ROPs + TMUs,
data = df_log)
cat("\n=================== KẾT QUẢ MÔ HÌNH 3 (LOGARITHM) ===================\n")
print(summary(Model3))
# 3. KIỂM ĐỊNH PHẦN DƯ
par(mfrow = c(2, 2))
plot(Model3)
par(mfrow = c(1, 1))
# 4. DỰ ĐOÁN GIÁ TRỊ
predicted_values <- predict(Model3, newdata = df_log)
comparison_table <- data.frame(
Actual_log = df_log$Core_Speed,
Predicted_log = predicted_values,
Actual_MHz = df_clean$Core_Speed,
Predicted_MHz = exp(predicted_values)
)
cat("\n--- BẢNG SO SÁNH (10 DÒNG ĐẦU) ---\n")
print(head(comparison_table, 10))
# 5. VẼ ĐỒ THỊ SO SÁNH
plot(predicted_values, df_log$Core_Speed,
main = "Plot to predict: Observed vs Predicted Values",
xlab = "Predicted values",
ylab = "Observed values",
col = "black", pch = 1)
abline(lm(df_log$Core_Speed ~ predicted_values), col = "red", lwd = 2)
suppressPackageStartupMessages(library(dplyr))
library(ggplot2)
library(gridExtra)
data_path <- "data/new_GPUs.csv"
df_clean <- read.csv(data_path)
df_log <- log(df_clean)
img_dir <- "../img/statisticDes"
if (!dir.exists(img_dir)) {
dir.create(img_dir, recursive = TRUE)
}
selected_cols <- c("Core_Speed", "Max_Power", "Memory", "Memory_Bandwidth",
"Memory_Bus", "Memory_Speed", "Process", "ROPs", "TMUs")
# =========================================================
# 1. Histogram Dữ liệu Gốc (Original) - 2 đồ thị / hàng
# =========================================================
hist_orig_list <- list()
for (col in selected_cols) {
p <- ggplot(df_clean, aes_string(x = col)) +
geom_histogram(fill = "gray70", color = "black", bins = 30) +
labs(title = paste("Histogram of", col), x = col, y = "Frequency") +
theme_minimal() +
theme(
plot.title = element_text(face = "bold", size = 11),
axis.title = element_text(size = 10)
)
hist_orig_list[[col]] <- p
}
png(file.path(img_dir, "histograms_original.png"), width = 10, height = 14, units = "in", res = 300)
grid.arrange(grobs = hist_orig_list, ncol = 2)
dev.off()
# =========================================================
# 2. Histogram Dữ liệu Log - 2 đồ thị / hàng
# =========================================================
hist_log_list <- list()
for (col in selected_cols) {
p <- ggplot(df_log, aes_string(x = col)) +
geom_histogram(fill = "gray85", color = "black", bins = 30) +
labs(title = paste0("Histogram of log(", col, ")"),
x = paste0("log(", col, ")"),
y = "Frequency") +
theme_minimal() +
theme(
plot.title = element_text(face = "bold", size = 11),
axis.title = element_text(size = 10)
)
hist_log_list[[col]] <- p
}
png(file.path(img_dir, "histograms_log.png"), width = 10, height = 14, units = "in", res = 300)
grid.arrange(grobs = hist_log_list, ncol = 2)
dev.off()
# =========================================================
# 3. Scatter Plots dạng Log (Core_Speed vs 8 biến còn lại) - 2 đồ thị / hàng
# =========================================================
feature_cols <- setdiff(selected_cols, "Core_Speed")
scatter_log_list <- list()
for (col in feature_cols) {
p <- ggplot(df_log, aes_string(x = col, y = "Core_Speed")) +
geom_point(color = "orange", alpha = 0.6, size = 1.5) +
labs(title = paste0("Scatter Plot of log(", col, ") with log(Core_Speed)"),
x = paste0("log(", col, ")"),
y = "log(Core_Speed)") +
theme_minimal() +
theme(
plot.title = element_text(face = "bold", size = 10),
axis.title = element_text(size = 10)
)
scatter_log_list[[col]] <- p
}
png(file.path(img_dir, "scatter_log.png"), width = 10, height = 12, units = "in", res = 300)
grid.arrange(grobs = scatter_log_list, ncol = 2)
dev.off()
